# Example environment variables for TimeTracker

# App
SECRET_KEY=please-change-this-secret-key
DEBUG=False
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# Database (default uses SQLite; override to use Postgres)
DATABASE_URL=sqlite+aiosqlite:///./data/timetracker.db
# POSTGRES example: postgresql://user:password@postgres:5432/timetracker
POSTGRES_URL=postgresql://user:password@postgres:5432/timetracker

# Redis for Celery (optional)
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=/api/v1

# Docker compose
HTTP_PORT=80
